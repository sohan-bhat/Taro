# ── MongoDB ─────────────────────────────────────────────────────────
# Free cluster at mongodb.com/atlas → Connect → Drivers → copy URI
# Include a database name in the path, e.g. ...mongodb.net/taro
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/taro

# ── Slack ───────────────────────────────────────────────────────────
# Create the app at api.slack.com/apps → "From an app manifest" using
# docs/slack-app-manifest.yaml. Then:
#   Basic Information → App Credentials → Client ID / Client Secret
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Basic Information → App-Level Tokens → create one with connections:write
# (starts with xapp-). Required for auto-join via Socket Mode.
SLACK_APP_TOKEN=

# ── Google Gemini (intent parsing) ──────────────────────────────────
# Free key at aistudio.google.com → Get API key
GOOGLE_API_KEY=
# Optional override; default is gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# ── MeetingBaas (meeting bot infrastructure) ────────────────────────
# Sign up at meetingbaas.com → API key. Free tier: 75 bots/day.
# IMPORTANT: realtime audio streaming (live commands) requires a v2 key and
# MEETINGBAAS_API_VERSION=v2. A v1 key still works for post-meeting processing.
MEETINGBAAS_API_KEY=mb-uWghVvvdiBCNHacceqDMAAmKhAqUYZhGczVKrzJwiWyoXjtkkjuikznhchUgS
# 'v1' (default) or 'v2'. Set to v2 with a v2 key to enable live commands.
MEETINGBAAS_API_VERSION=v2

# ── GitHub App (Taro's bot identity for filing issues) ──────────────
# Create at github.com/settings/apps/new (see README "GitHub App").
# App ID is shown at the top of the app's settings page.
GITHUB_APP_ID=
# The slug from the app's public URL: github.com/apps/<slug>
GITHUB_APP_SLUG=
# The downloaded private key, base64-encoded on one line:
#   base64 -i taro.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# ── Realtime transcription (optional upgrade) ───────────────────────
# Leave all blank to use the free in-process sherpa-onnx model.
# For scalable cloud transcription (free tier), use Groq Whisper:
#   get a key at console.groq.com -> API Keys
# GROQ_API_KEY=
# Or run the local faster-whisper server (packages/api/stt-server):
# STT_WS_URL=ws://localhost:8012

# ── URLs ────────────────────────────────────────────────────────────
# API_URL must be PUBLIC (MeetingBaas webhooks + Slack OAuth callback).
# For local dev: ngrok http 4000 --domain=<your-static-domain>
API_URL=https://your-static-domain.ngrok-free.app
# Where the API redirects back to after Slack OAuth (the dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NOTE: the dashboard talks to http://localhost:4000 by default. To change
# that, create apps/web/.env.local with NEXT_PUBLIC_API_URL=<url> — Next.js
# does NOT read this root .env file.
