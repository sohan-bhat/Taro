# Taro API configuration. Copy to .env for local development; on a host, set these
# as environment variables. docs/DEPLOY.md walks through every value.
#
# Provider keys (MeetingBaas, AI models, transcription) do NOT go here. Each
# workspace adds its own in the dashboard and they are stored encrypted.

# Core
# MongoDB connection string, including a database name (…mongodb.net/taro)
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/taro

# Encrypts every stored provider key and signs sign-in state. Generate once and
# keep it safe; if it changes, stored keys can no longer be read.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Public https URL of this API. Slack, GitHub, and MeetingBaas call back to it.
API_URL=https://api.your-domain.com
# The dashboard. Sign-in and installs send people back here.
APP_URL=https://app.your-domain.com
# Extra dashboard origins to trust, comma separated (preview deployments, etc.)
# WEB_ORIGINS=https://taro-git-main-you.vercel.app
# Taro for Google Meet (apps/extension): the extension IDs allowed to call this API, comma separated.
# lkdndnkaapmpibnjmaiadheckoflifde is the unpacked development build; add the store IDs once published.
# EXTENSION_IDS=lkdndnkaapmpibnjmaiadheckoflifde

# Slack app (required: sign-in and meeting discovery)
# Create it from docs/slack-app-manifest.yaml at api.slack.com/apps.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# App-level token with connections:write (starts with xapp-). Lets Taro see meeting links.
SLACK_APP_TOKEN=

# GitHub App (optional: issues and pull requests)
GITHUB_APP_ID=
# The slug in github.com/apps/<slug>
GITHUB_APP_SLUG=
# The private key, base64 encoded on one line:  base64 -i key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=
# OAuth credentials from the same app; used to confirm installations belong to whoever connects them.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional
# PORT=4000
# Name the bot shows in meetings by default (workspaces can rename it)
# BOT_NAME=Taro
# Public https image for the bot's avatar (defaults to API_URL/taro-bot.jpg)
# BOT_IMAGE_URL=
# Concurrent meetings allowed per workspace
# MAX_ACTIVE_MEETINGS_PER_WORKSPACE=5
# Proxies in front of the API (1 on Render, Railway, and Fly; 0 when nothing is in front)
# TRUST_PROXY_HOPS=1
# LOG_LEVEL=info

# Transcription this server hosts for every workspace, instead of per-workspace keys:
# a faster-whisper server (packages/api/stt-server) ...
# STT_WS_URL=ws://localhost:8012
# ... or the in-process sherpa-onnx model (development; see README)
# LOCAL_ASR=1

# Self-hosters running a model on their own network (for example Ollama) can allow
# private addresses for the Custom AI provider. Never enable on a shared server.
# ALLOW_PRIVATE_LLM_ENDPOINTS=1

# Writes raw meeting audio and transcripts to disk for debugging. Never in production.
# REALTIME_DEBUG=1

# Dashboard (apps/web)
# Next.js reads its own env, not this file. On Vercel set these in the project
# settings; locally put them in apps/web/.env.local.
#   NEXT_PUBLIC_API_URL=https://api.your-domain.com
#   NEXT_PUBLIC_SITE_URL=https://app.your-domain.com
#   NEXT_PUBLIC_REPO_URL=https://github.com/you/taro   (optional footer link)
