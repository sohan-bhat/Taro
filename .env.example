# MongoDB (create free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/taro

# Slack App (create at api.slack.com/apps)
# Bot token scopes: chat:write, channels:read, channels:join, channels:history, users:read
# Event subscriptions: message.channels (Socket Mode)
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret
SLACK_SIGNING_SECRET=your-signing-secret
# App-level token for Socket Mode (connections:write scope). Optional — without
# it the Slack auto-join listener is disabled, but manual join still works.
SLACK_APP_TOKEN=xapp-...

# Google Gemini (aistudio.google.com). Optional — without it Taro falls back
# to a regex-based intent parser.
GOOGLE_API_KEY=your-gemini-api-key
# Override if the default model is ever deprecated
GEMINI_MODEL=gemini-3.5-flash

# MeetingBaas (meetingbaas.com)
MEETINGBAAS_API_KEY=your-meetingbaas-api-key

# URLs
# API_URL must be publicly reachable by MeetingBaas webhooks.
# For local dev: run `ngrok http 4000` and put the ngrok URL here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_URL=http://localhost:4000

PORT=4000
