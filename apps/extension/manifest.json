{
  "manifest_version": 3,
  "name": "Taro for Google Meet",
  "short_name": "Taro",
  "version": "0.1.0",
  "description": "Invite Taro, the voice assistant for your meetings, into a Google Meet call with one click.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "src/popup.html", "default_title": "Taro", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [{ "matches": ["https://meet.google.com/*"], "js": ["src/content.js"], "run_at": "document_idle" }],
  "permissions": ["storage", "activeTab"],
  "storage": { "managed_schema": "managed_schema.json" },
  "externally_connectable": { "matches": ["https://trytaro.vercel.app/*", "http://localhost/*"] },
  "web_accessible_resources": [
    { "resources": ["src/lib/meet.js", "src/lib/pill.js", "fonts/SchibstedGrotesk-SemiBold.woff2"], "matches": ["https://meet.google.com/*"] }
  ]
}
