{
  "name": "@taro/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=test.env --import tsx --test \"src/**/*.test.ts\"",
    "export-demo": "tsx src/scripts/export-demo.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.13.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@taro/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ical.js": "^2.2.1",
    "mongoose": "^8.0.0",
    "postal-mime": "^2.7.6",
    "undici": "^8.11.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "^1.13.4"
  },
  "engines": {
    "node": ">=22"
  }
}
