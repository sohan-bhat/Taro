# Dummy values so unit tests run without real credentials or a database.
NODE_ENV=test
MONGODB_URI=mongodb://127.0.0.1:27017/taro-test
ENCRYPTION_KEY=dGVzdC1vbmx5LWtleS1kby1ub3QtdXNlLWluLXByb2R1Y3Rpb24hIQ==
SLACK_CLIENT_ID=test-client-id
SLACK_CLIENT_SECRET=test-client-secret
API_URL=https://api.taro.test
APP_URL=https://app.taro.test
WEB_ORIGINS=https://preview.taro.test
EXTENSION_IDS=abcdefghijklmnopabcdefghijklmnop
LOG_LEVEL=error
# Calendar invitations, so the webhook and address tests run
INVITE_ADDRESS={token}@invite.taro.test
INBOUND_SECRET=test-inbound-secret-0123456789abcdef
# Google sign-in and Connect Google Calendar, so the shared callback tests run
GOOGLE_CLIENT_ID=test-google-client.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test-google-client-secret
